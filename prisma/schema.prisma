generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql" // ou "sqlite", "mysql"
}

model Exercise {
  id                String   @id @default(uuid())
  name              String
  targetMuscleGroup String
  description       String?
  createdAt         DateTime @default(now())
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
